{
  "opencollection": "1.0.0",
  "info": {
    "name": "Core accepted countries kyc API",
    "version": "3.0.39"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "kyc",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Performs a KYC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v3/kyc",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Performs a KYC"
        },
        {
          "info": {
            "name": "Lists all KYC results for a business",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v3/kyc/business/:business_token",
            "params": [
              {
                "name": "business_token",
                "value": "",
                "type": "path",
                "description": "Business token"
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of items to retrieve"
              },
              {
                "name": "start_index",
                "value": "",
                "type": "query",
                "description": "Start index"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-delimited list of fields to return (e.g. field_1,field_2,..). Leave blank to return all fields."
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query",
                "description": "Sort order"
              }
            ]
          },
          "docs": "Lists all KYC results for a business"
        },
        {
          "info": {
            "name": "Lists all KYC results for a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v3/kyc/user/:user_token",
            "params": [
              {
                "name": "user_token",
                "value": "",
                "type": "path",
                "description": "User token"
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of items to retrieve"
              },
              {
                "name": "start_index",
                "value": "",
                "type": "query",
                "description": "Start index"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-delimited list of fields to return (e.g. field_1,field_2,..). Leave blank to return all fields."
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query",
                "description": "Sort order"
              }
            ]
          },
          "docs": "Lists all KYC results for a user"
        },
        {
          "info": {
            "name": "Returns a specific KYC result",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v3/kyc/:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path",
                "description": "KYC token"
              }
            ]
          },
          "docs": "Returns a specific KYC result"
        }
      ]
    }
  ],
  "bundled": true
}