    {
      "id": "f073dc04-706a-45ca-a195-842548b83f8b",
      "name": "Account Transitions",
      "description": {
        "content": "// Conditional snippet for beta or internal content\ninclude::../../maturity-admonition-banner.adoc[]\n\nUse the account transitions endpoints to create and retrieve account transitions on Marqeta's credit platform.\nAn account transition occurs when a <</core-api/credit-accounts, credit account>> transitions to a new status.\n\nTo receive webhook notifications when account transition events occur, see <</core-api/event-types#_credit_account_transition_events, Credit account transition events>> in Event Types.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a4bcaac6-2eb4-4075-b316-82e582c489b6",
          "name": "List account transitions",
