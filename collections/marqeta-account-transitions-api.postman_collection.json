              "content": "Retrieve an array of transitions on a credit account.\n\nThis endpoint supports <</core-api/sorting-and-pagination, sorting and pagination>>.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_token",
                "accounttransitions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "count",
                  "value": "5",
                  "description": "Number of account transition resources to retrieve."
                },
                {
                  "disabled": false,
                  "key": "start_index",
                  "value": "0",
                  "description": "Sort order index of the first resource in the returned array."
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "-createdTime",
                  "description": "Field on which to sort.\nPrefix the field name with a hyphen (`-`) to sort in descending order.\nOmit the hyphen to sort in ascending order.\n\n*NOTE:*\nYou must sort using system field names such as `createdTime`, and not by the field names appearing in response bodies such as `created_time`."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_token",
                  "description": "(Required) Unique identifier of the credit account for which you want to retrieve transitions.\n\nSend a `GET` request to `/credit/accounts` to retrieve existing credit account tokens."
