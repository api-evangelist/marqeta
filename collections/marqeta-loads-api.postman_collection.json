                  "disabled": false,
                  "key": "program",
                  "value": "<string>",
                  "description": "(Required) The name of your Marqeta card program. This parameter is required for most DiVA API endpoints to scope the data to your program."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-delimited list of fields to include in the response. If not specified, all available fields are returned."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Start date for filtering data (format YYYY-MM-DD). Returns records on or after this date."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "End date for filtering data (format YYYY-MM-DD). Returns records on or before this date."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. Use 'json' for JSON responses or 'csv' for comma-separated bulk file format. Defaults to json."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "1000",
                  "description": "Maximum number of records to return per request."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Zero-based offset for pagination."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "time_agg",
                  "description": "(Required) Aggregation time level for the data. Use 'day' for daily rollups, 'week' for weekly rollups, 'month' for monthly rollups, or 'detail' for individual record-level data."
                }
              ]
            },
            "header": [
