        {
          "id": "1d6c5916-312b-4163-b702-b90ef21900c8",
          "name": "Create balance refund",
          "request": {
            "name": "Create balance refund",
            "description": {
              "content": "Create a new balance refund, which can be issued to the account holder if their credit account balance is negative.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_token",
                "creditbalancerefunds"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_token",
                  "description": "(Required) Unique identifier of the credit account for which you want to create a balance refund.\n\nSend a `GET` request to `/credit/accounts` to retrieve existing credit account tokens."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
