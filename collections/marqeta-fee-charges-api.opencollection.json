{
  "opencollection": "1.0.0",
  "info": {
    "name": "Core accepted countries fee charges API",
    "version": "3.0.39"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
