            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a fee charge"
        },
        {
          "info": {
            "name": "Creates a realTime fee charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v3/feecharges/realtime",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a realTime fee charge"
        },
        {
          "info": {
            "name": "Returns a fee charge",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v3/feecharges/:token",
            "params": [
              {
                "name": "token",
                "value": "",
