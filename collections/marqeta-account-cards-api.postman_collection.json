          "name": "Create account card",
          "request": {
            "name": "Create account card",
            "description": {
              "content": "Create a credit card for an existing credit account.\n\n[NOTE]\nYou can ship cards to an address different from the <</core-api/users, user>> address.\nAfter creating a card, send a `PUT` request to the `/cards` endpoint with the new address in the `fulfillment.shipping` object.\nFor more, see <</core-api/cards#putCardsToken, Update card>>.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_token",
                "cards"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_token",
                  "description": "(Required) Unique identifier of the credit account for which to create a credit card.\n\nSend a `GET` request to `/credit/accounts` to retrieve existing credit account tokens."
