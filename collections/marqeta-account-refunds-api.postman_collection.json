                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "End of the date range of the refunds to return."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "5",
                  "description": "Number of account refund resources to retrieve."
                },
                {
                  "disabled": false,
                  "key": "start_index",
                  "value": "0",
                  "description": "Sort order index of the first resource in the returned array."
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "-lastModifiedTime",
                  "description": "Field on which to sort.\nPrefix the field name with a hyphen (`-`) to sort in descending order.\nOmit the hyphen to sort in ascending order.\nOnly supports `lastModifiedTime` and `-lastModifiedTime`.\n\n*NOTE:*\nYou must sort using system field names such as `lastModifiedTime`, and not by the field names appearing in response bodies such as `updated_time`."
                },
                {
                  "disabled": false,
                  "key": "statuses",
                  "value": "<string>",
                  "description": "Array of statuses by which to filter refunds."
