    {
      "id": "a29d05ae-1f1b-4067-9b65-770eb466d1bb",
      "name": "Account Refunds",
      "description": {
        "content": "// Conditional snippet for beta or internal content\ninclude::../../maturity-admonition-banner.adoc[]\n\nUse the account refunds endpoints to create and retrieve account refunds on Marqeta's credit platform.\n\nYou can issue account refunds to your cardholders with negative account balances.\nThe maximum refund amount is the amount that brings the account balance to $0.\nFor example, $4000 is the maximum refund amount for a -$4000 account balance.",
        "type": "text/plain"
      },
      "item": [
