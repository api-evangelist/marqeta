        {
          "info": {
            "name": "Echo test for sending payload to server",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v3/ping",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Echo test for sending payload to server"
        }
      ]
    }
  ],
  "bundled": true
